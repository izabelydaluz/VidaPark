    },

    "android": {
      "package": "com.vidapark.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "extra": {
      "eas": {
        "projectId": "58b10e3e-6412-4f2f-bc39-1111b21ed578"
      }
    },

    "owner": "mateusdeboit"
  }
}